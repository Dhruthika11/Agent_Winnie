# ---- Model / Inference ----
MODEL_NAME=NousResearch/Hermes-3-Llama-3.1-8B
HF_TOKEN=hf_xxxxxxxxxxxxxxxxxxxx
LITELLM_BASE_URL=http://localhost:4000
LITELLM_MASTER_KEY=sk-litellm-local

# ---- Agent behavior ----
MAX_AGENT_ITERATIONS=8
HITL_APPROVAL_TIMEOUT_SECONDS=300

# ---- Memory (Mem0) ----
MEM0_API_KEY=
MEM0_VECTOR_STORE=qdrant
MEM0_VECTOR_STORE_URL=http://localhost:6333

# ---- Datastores ----
REDIS_URL=redis://localhost:6379/0
POSTGRES_URL=postgresql://hermes:hermes@localhost:5432/hermes_agent

# ---- Observability ----
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=http://localhost:3000
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318

# ---- Guardrails ----
GUARDRAILS_API_KEY=

# ---- Sandbox ----
SANDBOX_IMAGE=python:3.11-slim
SANDBOX_TIMEOUT_SECONDS=20
SANDBOX_NETWORK_DISABLED=true
SANDBOX_MCP_URL=http://127.0.0.1:8005/sse
SANDBOX_RUNTIME=  # Set to 'runsc' for gVisor / MicroVM isolation

# ---- Authentication & RBAC ----
AUTH_ENABLED=false
JWT_SECRET_KEY=change-this-jwt-secret-in-production
API_KEYS=  # Comma-separated list of pre-shared API keys

# ---- Rate Limiting (Token Bucket) ----
RATE_LIMIT_ENABLED=true
RATE_LIMIT_RPM=60

# ---- Enterprise Secret Management ----
SECRET_BACKEND=env  # Options: env, aws_secrets_manager, vault, gcp_secret_manager
VAULT_ADDR=http://localhost:8200
VAULT_TOKEN=
AWS_SECRET_NAME=hermes/production
AWS_REGION=us-east-1

# ---- Distributed State & Checkpointer ----
CHECKPOINTER_BACKEND=auto  # Options: auto, postgres, memory

# ---- FinOps Spending Controls ----
FINOPS_BUDGET_DEGRADATION_PCT=80
FINOPS_BUDGET_BLOCK_PCT=100
